<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for ALL socket use (discovery, cert exchange, TLS transfer).
         Flutter only declares this in the debug/ and profile/ manifests, so
         without it here a *release* build has no network access at all: the
         cert fetch on port 7980 fails and surfaces to the user as
         "Could not get <device>'s certificate", which looks like a
         certificate bug but is really a missing permission. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Publishing received files to the gallery needs no permission on
         API 29+ (scoped storage: the app owns what it inserts into
         MediaStore). Only the pre-Q direct-write path does. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>
    <!-- A transfer holds a CPU wake lock and a Wi-Fi lock for its duration.
         Without them a screen timeout mid-transfer lets the OS suspend the
         app's network, which the peer sees as the connection being reset.
         Held only while a send/receive is active, never for the app's
         lifetime — see TransferService. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Locks held by an Activity do not protect the process: a backgrounded
         app can still be frozen or killed, and a large file over a slow link
         takes far longer than a user will sit watching the screen. A
         foreground service is the only sanctioned way to keep a long transfer
         running, and dataSync is its type — this is a file transfer the user
         explicitly started, not background work. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- API 33+ only: without it the ongoing notification is silently hidden.
         The service still runs, so a denial costs visibility, not the
         transfer. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="linkdrop_app"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Lets a received file that never made it into the gallery still
             be opened by another app. A raw file:// URI cannot cross app
             boundaries on modern Android, so handing out a temporary
             content:// grant is the only way. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Holds the CPU and Wi-Fi locks for the life of a transfer, so it
             survives the app being backgrounded or the screen going off.
             Not exported: nothing outside the app has any business starting
             it. -->
        <service
            android:name=".TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
